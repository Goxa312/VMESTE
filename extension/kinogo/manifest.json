{
  "manifest_version": 3,
  "name": "Together Tonight — просмотр Киного",
  "version": "0.4.1",
  "description": "Синхронизация выбранного HTML5-видео на Киного с открытой комнатой Together Tonight.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "scripting", "alarms"],
  "optional_permissions": ["browsingData"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*", "https://vmeste.dadvanigeorgii.workers.dev/*", "https://kinogo.my/*", "https://www.kinogo.my/*", "https://kinogomy.stravers.live/*"],
  "background": { "service_worker": "background.mjs", "type": "module" },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*", "http://localhost/*", "https://vmeste.dadvanigeorgii.workers.dev/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://kinogo.my/*", "https://www.kinogo.my/*", "https://kinogomy.stravers.live/*"],
      "js": ["media-controller.js", "media-selection.js", "media-sources.js", "media.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "action": { "default_title": "Together Tonight — состояние просмотра", "default_popup": "popup.html" }
}
