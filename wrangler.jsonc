{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vmeste",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": { "crons": ["17 * * * *"] },
  "durable_objects": { "bindings": [{ "name": "ROOM_RELAY", "class_name": "RoomRelay" }] },
  "migrations": [{ "tag": "room-relay-v1", "new_sqlite_classes": ["RoomRelay"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vmeste-db",
      "database_id": "6f8c3b2c-695c-4e39-9568-c255780992af",
      "migrations_dir": "drizzle"
    }
  ]
}
